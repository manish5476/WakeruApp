  // --- Types ---

  // --- Default Controls ---
  var DEFAULT_CONTROLS = {
    showZoom: true,
    showFullscreen: false,
    showLocate: true,
    showLegend: true,
    showAttribution: false,
    showScale: true,
    showLayerToggle: true
